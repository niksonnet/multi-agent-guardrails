#!/bin/sh
# Never commit secret files (.env, .env.local, ...). .gitignore stops `git add .`,
# but `git add -f` gets past it. This hook stops the commit itself.
# Enable once per clone: git config core.hooksPath .githooks

blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -vE '(^|/)\.env\.example$')

if [ -n "$blocked" ]; then
  echo "Commit blocked: secret file(s) are staged:"
  echo "$blocked" | sed 's/^/  /'
  echo "Unstage with: git rm --cached <file>"
  exit 1
fi
